# Public announcement/update feed directory. HTTP is allowed for SZU intranet deployments.
SZU_LIFE_BASE_URL=http://127.0.0.1:8080/your-szu-life
# Optional independent fallback source.
# SZU_LIFE_FALLBACK_BASE_URL=https://mirror.example/your-szu-life

# Aptabase anonymous analytics app key (A-US-... / A-EU-...).
# Leave unset or empty to disable analytics; local development should normally leave it empty.
# APTABASE_APP_KEY=
