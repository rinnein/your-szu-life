{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "authserver-credential-capture",
  "description": "Allows the active authentication WebView to use the local credential capture bridge.",
  "local": false,
  "windows": ["main"],
  "remote": {
    "urls": ["https://*"]
  },
  "permissions": ["allow-capture-auth-credentials", "allow-control-auth-recovery"]
}
