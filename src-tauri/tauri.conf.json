{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "泥深",
  "mainBinaryName": "your-szu-life",
  "version": "../package.json",
  "identifier": "in.rinne.your-szu-life",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "泥深",
        "width": 800,
        "height": 600,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["your-szu-life"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Rinne",
    "homepage": "https://github.com/rinnein/your-szu-life",
    "category": "Utility",
    "shortDescription": "泥深 - 你的SZU助手",
    "externalBin": ["binaries/aria2c"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/ocr/ddddocr/model.json": "resources/ocr/ddddocr/model.json",
      "resources/ocr/ddddocr/LICENSE-ddddocr": "resources/ocr/ddddocr/LICENSE-ddddocr",
      "../node_modules/socket.io-client/LICENSE": "resources/licenses/socket.io-client.txt",
      "resources/licenses/modern-monaco.txt": "resources/licenses/modern-monaco.txt",
      "../node_modules/typescript-lsp/LICENSE.txt": "resources/licenses/typescript-lsp.txt",
      "../node_modules/tm-grammars/LICENSE": "resources/licenses/tm-grammars.txt",
      "../node_modules/tm-themes/LICENSE": "resources/licenses/tm-themes.txt"
    },
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional",
        "desktopTemplate": "linux/your-szu-life.desktop",
        "files": {
          "/usr/share/metainfo/in.rinne.your-szu-life.metainfo.xml": "linux/your-szu-life.metainfo.xml"
        }
      },
      "appimage": {
        "bundleMediaFramework": false,
        "files": {
          "/usr/share/metainfo/in.rinne.your-szu-life.metainfo.xml": "linux/your-szu-life.metainfo.xml"
        }
      }
    }
  }
}
